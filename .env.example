# Database connection (SQLite for local zero-config, or PostgreSQL in production)
# SQLite: file:./dev.db
# PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="file:./dev.db"

# Authentication secret (Random 32+ character key for JWT tokens)
AUTH_SECRET="replace-with-a-secure-random-32-character-secret"

# OpenAI API Key for AI Command Center
OPENAI_API_KEY=""

# Meta Marketing API Credentials
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/integrations/meta/callback"

# Stripe API & Webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

