datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  passwordHash   String
  name           String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  memberships    OrganizationMember[]
  activityLogs   ActivityLog[]
  assignedTickets SupportTicket[]
  ticketNotes    TicketNote[]
}

model Organization {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  members                OrganizationMember[]
  revenueRecords         RevenueRecord[]
  businessMetrics        BusinessMetric[]
  socialAccounts         SocialAccount[]
  socialPosts            SocialPost[]
  adAccounts             AdAccount[]
  subscriptionPlans      SubscriptionPlan[]
  subscribers            Subscriber[]
  supportTickets         SupportTicket[]
  conversations          Conversation[]
  integrationCredentials IntegrationCredential[]
  activityLogs           ActivityLog[]
  agentDevices           AgentDevice[]
  agentPairingCodes      AgentPairingCode[]
  agentTasks             AgentTask[]
  visionSessions         VisionSession[]
  outboxEvents           OutboxEvent[]
  aiUsageLogs            AIUsageLog[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("OWNER") // OWNER, ADMIN, MANAGER, VIEWER
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model RevenueRecord {
  id             String       @id @default(cuid())
  organizationId String
  amount         Float
  currency       String       @default("USD")
  source         String       @default("MANUAL") // STRIPE, REVENUECAT, MANUAL
  category       String       @default("SUBSCRIPTION") // SUBSCRIPTION, ONE_TIME, AD_REVENUE
  recordedAt     DateTime     @default(now())
  notes          String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model BusinessMetric {
  id             String       @id @default(cuid())
  organizationId String
  metricKey      String       // MRR, ARR, ACTIVE_USERS, REVENUE_MTD
  value          Float
  delta          Float        @default(0.0)
  period         String       @default("MONTHLY")
  recordedAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model SocialAccount {
  id             String       @id @default(cuid())
  organizationId String
  platform       String       // INSTAGRAM, X, LINKEDIN
  accountName    String
  status         String       @default("DISCONNECTED") // CONNECTED, DISCONNECTED
  connectedAt    DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts          SocialPost[]
}

model SocialPost {
  id                  String         @id @default(cuid())
  organizationId      String
  socialAccountId     String?
  platform            String         // Instagram, X, LinkedIn
  content             String
  scheduledFor        DateTime?
  scheduledTimeString String?
  status              String         @default("DRAFT") // DRAFT, SCHEDULED, PUBLISHED, FAILED
  errorMessage        String?
  publishedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialAccount       SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
}

model AdAccount {
  id             String       @id @default(cuid())
  organizationId String
  platform       String       @default("META")
  accountName    String       @default("Meta Ads")
  status         String       @default("DISCONNECTED") // CONNECTED, DISCONNECTED
  currency       String       @default("USD")
  totalSpend     Float        @default(0.0)
  avgCtr         Float        @default(0.0)
  blendedRoas    Float        @default(0.0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns      AdCampaign[]
}

model AdCampaign {
  id          String    @id @default(cuid())
  adAccountId String
  name        String
  status      String    @default("ACTIVE") // ACTIVE, PAUSED, ARCHIVED
  spend       Float     @default(0.0)
  impressions Int       @default(0)
  clicks      Int       @default(0)
  ctr         Float     @default(0.0)
  roas        Float     @default(0.0)
  conversions Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id             String       @id @default(cuid())
  organizationId String
  name           String       // Starter, Pro, Enterprise
  price          Float
  interval       String       @default("month")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscribers    Subscriber[]
}

model Subscriber {
  id             String           @id @default(cuid())
  organizationId String
  planId         String
  customerEmail  String
  status         String           @default("ACTIVE") // ACTIVE, CANCELLED, PAST_DUE
  startDate      DateTime         @default(now())
  renewalDate    DateTime?
  cancelledAt    DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id               String       @id @default(cuid())
  ticketNumber     Int          @default(1001)
  organizationId   String
  subject          String
  requesterEmail   String
  priority         String       @default("MEDIUM") // HIGH, MEDIUM, LOW
  status           String       @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  assignedToUserId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo       User?        @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  notes            TicketNote[]
}

model TicketNote {
  id         String        @id @default(cuid())
  ticketId   String
  authorId   String
  content    String
  isInternal Boolean       @default(true)
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  title          String       @default("Jarvis Session")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String       // user, ai, system
  text           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model IntegrationCredential {
  id             String       @id @default(cuid())
  organizationId String
  provider       String       // OPENAI, META, STRIPE, REVENUECAT, ZENDESK, TWITTER, LINKEDIN
  status         String       @default("DISCONNECTED") // CONNECTED, DISCONNECTED, ERROR
  apiKeyMasked   String?
  metadataJson   String?
  lastSyncedAt   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  details        String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AgentDevice {
  id             String             @id @default(cuid())
  organizationId String
  deviceName     String
  platform       String             @default("windows")
  osVersion      String?
  ipAddress      String?
  status         String             @default("ONLINE") // ONLINE, OFFLINE, PAIRED, REVOKED
  lastSeenAt     DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credentials    AgentCredential[]
  permissions    DevicePermission[]
  tasks          AgentTask[]
  visionSessions VisionSession[]
}

model AgentCredential {
  id               String      @id @default(cuid())
  deviceId         String
  tokenHash        String
  refreshTokenHash String
  scopes           String      @default("metrics:read,tickets:read,tickets:write,social:read,social:write,desktop:control,vision:upload")
  expiresAt        DateTime
  createdAt        DateTime    @default(now())
  device           AgentDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model AgentPairingCode {
  id             String       @id @default(cuid())
  code           String       @unique
  organizationId String
  userId         String
  expiresAt      DateTime
  used           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model DevicePermission {
  id        String      @id @default(cuid())
  deviceId  String
  scope     String
  granted   Boolean     @default(true)
  updatedAt DateTime    @updatedAt
  device    AgentDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, scope])
}

model AgentTask {
  id             String          @id @default(cuid())
  organizationId String
  deviceId       String?
  title          String
  goal           String
  status         String          @default("QUEUED") // QUEUED, RUNNING, PAUSED, COMPLETED, FAILED, CANCELLED
  priority       String          @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  riskLevel      String          @default("LOW") // LOW, MEDIUM, HIGH
  confirmed      Boolean         @default(false)
  result         String?
  error          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device         AgentDevice?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  steps          AgentTaskStep[]
}

model AgentTaskStep {
  id             String    @id @default(cuid())
  taskId         String
  stepNumber     Int
  toolName       String
  parametersJson String?
  outputJson     String?
  status         String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, SKIPPED
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  task           AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model VisionSession {
  id             String       @id @default(cuid())
  organizationId String
  deviceId       String?
  title          String       @default("Screen Analysis")
  imagePath      String?
  ocrText        String?
  analysis       String?
  status         String       @default("ANALYZED") // CAPTURED, PROCESSING, ANALYZED, FAILED
  metadataJson   String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device         AgentDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
}

model OutboxEvent {
  id             String       @id @default(cuid())
  organizationId String
  eventType      String // METRIC_UPDATED, TASK_COMPLETED, DEVICE_PAIRED, TICKET_CREATED, VISION_ANALYZED
  payloadJson    String
  status         String       @default("PENDING") // PENDING, PUBLISHED, FAILED
  createdAt      DateTime     @default(now())
  publishedAt    DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AIUsageLog {
  id               String       @id @default(cuid())
  organizationId   String
  model            String
  promptTokens     Int          @default(0)
  completionTokens Int          @default(0)
  latencyMs        Int          @default(0)
  costUsd          Float        @default(0.0)
  createdAt        DateTime     @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}


